{
  "name": "rueckwaertssuche",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokale Telefonnummernsuche in OpenStreetMap und PhoneBlock",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "libphonenumber-geo-carrier": "^2.0.0",
    "libphonenumber-js": "^1.12.0"
  }
}
